<Window x:Class="Recepti.AddEditRecipeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Height="700"
        Width="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

       
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>

            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FF6FA1"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border CornerRadius="20"
            Background="White">

        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="0"
                              Opacity="0.3"/>
        </Border.Effect>

        <Grid>

          
            <Image Source="pack://application:,,,/Images/background.jpeg"
                   Stretch="UniformToFill">
                <Image.Effect>
                    <BlurEffect Radius="15"/>
                </Image.Effect>
            </Image>

            
            <Rectangle Fill="#80FFFFFF"
                       IsHitTestVisible="False"/>

           
            <Border CornerRadius="20"
                    Background="Transparent"
                    Padding="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="850"
                    Height="650">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    
                    <Border Grid.Row="0" Grid.ColumnSpan="2"
                            Background="#FFF0F0"
                            CornerRadius="10"
                            Padding="5"
                            Margin="0,5">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Name *:" VerticalAlignment="Center"/>
                            <TextBox x:Name="TitleBox" Grid.Column="1"/>

                            <TextBlock x:Name="TitleError"
                                       Grid.Column="1"
                                       Margin="0,35,0,0"
                                       Foreground="Red"
                                       FontSize="10"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="2"
                            Background="#FFF0F0"
                            CornerRadius="10"
                            Padding="5"
                            Margin="0,5">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Servings:" VerticalAlignment="Center"/>
                            <TextBox x:Name="ServingsBox" Grid.Column="1"/>

                            <TextBlock x:Name="ServingsError"
                                       Grid.Column="1"
                                       Margin="0,35,0,0"
                                       Foreground="Red"
                                       FontSize="10"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.ColumnSpan="2"
                            Background="#FFF0F0"
                            CornerRadius="10"
                            Padding="5"
                            Margin="0,5">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Image *:" Width="120"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="ChooseImageButton"
                                    Content="Choose Image"
                                    Click="ChooseImageButton_Click"
                                    Background="LightGray"/>

                            <Image x:Name="ImagePreview"
                                   Width="50"
                                   Height="50"
                                   Margin="10,0"/>

                            <TextBlock x:Name="ImageError"
                                       Foreground="Red"
                                       FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,5">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="B" Click="Bold_Click" Width="30"/>
                            <Button Content="I" Click="Italic_Click" Width="30"/>
                            <Button Content="U" Click="Underline_Click" Width="30"/>
                        </StackPanel>

                        <TextBlock Text="Font:" Grid.Column="3" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FontComboBox"
                                  Grid.Column="4"
                                  Width="140"
                                  Loaded="FontComboBox_Loaded"
                                  SelectionChanged="FontComboBox_SelectionChanged"/>

                        <TextBlock Text="Size:" Grid.Column="5" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FontSizeComboBox"
                                 Grid.Column="6"
                                 Width="60"
                                 Loaded="FontSizeComboBox_Loaded"
                                 SelectionChanged="FontSizeComboBox_SelectionChanged"/>

                        <TextBlock Text="Color:" Grid.Column="7" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ColorComboBox"
                                Grid.Column="8"
                                Width="120"
                                Loaded="ColorComboBox_Loaded"
                                SelectionChanged="ColorComboBox_SelectionChanged"/>

                    </Grid>

                    <TextBlock Text="Instructions *:"
                         Grid.Row="4"
                         Grid.Column="0"
                         FontSize="18"
                         VerticalAlignment="Top"
                         Margin="0,5"/>
                    
                    <ScrollViewer Grid.Row="4"
                          Grid.ColumnSpan="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                        
                    <RichTextBox x:Name="InstructionsBox"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Margin="0,5"
                                 Padding="5"
                                 BorderBrush="#FF6FA1"
                                 BorderThickness="1"
                                 Background="White"
                                 VerticalScrollBarVisibility="Auto"/>
                    </ScrollViewer>

                    <TextBlock x:Name="InstructionsError"
                               Grid.Row="5"
                               Grid.Column="1"
                               Foreground="Red"
                               FontSize="10"
                               Margin="0,5,0,0"/>

                    <StatusBar Grid.Row="6" Grid.Column="1">
                        <TextBlock x:Name="WordCountText"
                                   Text="Words: 0"/>
                    </StatusBar>

                    <StackPanel Grid.Row="7"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,5">

                        <Button x:Name="SaveButton"
                                Content="Save"
                                Width="80"
                                Click="SaveButton_Click"/>

                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Width="80"
                                Margin="10,0"
                                Click="CancelButton_Click"/>

                    </StackPanel>

                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
