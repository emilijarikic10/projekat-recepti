<Window x:Class="Recepti.DetailViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Height="600"
        Width="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border CornerRadius="20"
            Background="White">

        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="0"
                              Opacity="0.3"/>
        </Border.Effect>

        <Grid>

            
            <Image Source="pack://application:,,,/Images/background.jpeg"
                   Stretch="UniformToFill">
                <Image.Effect>
                    <BlurEffect Radius="15"/>
                </Image.Effect>
            </Image>

           
            <Rectangle Fill="#80FFFFFF"
                       IsHitTestVisible="False"/>

            
            <Border CornerRadius="20"
                    Background="Transparent"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="800"
                    Height="550">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    
                    <Border Grid.Row="0" Grid.ColumnSpan="2"
                            Background="#FFF0F0"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,5">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Title:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TitleText"
                                       Grid.Column="1"
                                       FontSize="16"/>
                        </Grid>
                    </Border>

                    
                    <Border Grid.Row="1" Grid.ColumnSpan="2"
                            Background="#FFF0F0"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,5">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Servings:"/>
                            <TextBlock x:Name="ServingsText" Grid.Column="1"/>
                        </Grid>
                    </Border>

                 
                    <Border Grid.Row="2" Grid.ColumnSpan="2"
                            Background="#FFF0F0"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,5">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Image:" Width="140"/>
                            <Image x:Name="RecipeImage"
                                   Width="120"
                                   Height="120"
                                   Margin="10,0"
                                   Stretch="UniformToFill"/>
                        </StackPanel>
                    </Border>

                   
                    <TextBlock Text="Instructions:"
                               Grid.Row="3"
                               Grid.Column="0"
                               FontSize="16"
                               VerticalAlignment="Top"
                               Margin="0,5"/>

                    <ScrollViewer Grid.Row="3"
                                  Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto">

                        <RichTextBox x:Name="InstructionsBox"
                                     IsReadOnly="True"
                                     Padding="10"
                                     BorderBrush="#FF6FA1"
                                     BorderThickness="1"
                                     Background="White"/>
                    </ScrollViewer>

                   
                    <Border Grid.Row="4" Grid.ColumnSpan="2"
                            Background="#FFF0F0"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,5">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Date Added:"/>
                            <TextBlock x:Name="DateAddedText" Grid.Column="1"/>
                        </Grid>
                    </Border>

                   
                    <Button Content="Back"
                            Grid.Row="5"
                            Width="120"
                            Height="35"
                            HorizontalAlignment="Center"
                            Margin="0,10"
                            Click="Back_Click"
                            Background="#FFF0F0"/>

                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>